{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "color": {
      "keys": "blue",
      "title": "cyan",
      "output": "white",
      "separator": "light_black"
    },
    "separator": ": ",
    "key": {
      "width": 18
    }
  },
  "logo": {
    "position": "left",
    "padding": {
      "bottom": 1
    }
  },
  "modules": [
    { "type": "custom", "key": " ", "format": "{#separator}╭─[{#title} Hardware {#separator}]────────────────────────{#}" },
    { "type": "host", "key": "{#separator}│ {#keys}Host" },
    { "type": "bios", "key": "{#separator}│ {#keys}BIOS" },
    { "type": "bootmgr", "key": "{#separator}│ {#keys}Bootloader" },
    { "type": "board", "key": "{#separator}│ {#keys}Board" },
    { "type": "cpu", "key": "{#separator}│ {#keys}CPU" },
    { "type": "gpu", "key": "{#separator}│ {#keys}GPU" },
    { "type": "memory", "key": "{#separator}│ {#keys}Memory" },
    { "type": "swap", "key": "{#separator}│ {#keys}Swap" },
    { "type": "disk", "key": "{#separator}│ {#keys}Disk" },
    { "type": "btrfs", "key": "{#separator}│ {#keys}Btrfs" },
    { "type": "battery", "key": "{#separator}│ {#keys}Battery" },
    { "type": "poweradapter", "key": "{#separator}│ {#keys}Power" },
    { "type": "custom", "key": " ", "format": "{#separator}╰────────────────────────────────────────{#}" },

    { "type": "custom", "key": " ", "format": "{#separator}╭─[{#title} System {#separator}]──────────────────────────{#}" },
    { "type": "os", "key": "{#separator}│ {#keys}OS" },
    { "type": "kernel", "key": "{#separator}│ {#keys}Kernel" },
    { "type": "uptime", "key": "{#separator}│ {#keys}Uptime" },
    { "type": "packages", "key": "{#separator}│ {#keys}Packages" },
    { "type": "display", "key": "{#separator}│ {#keys}Display" },
    { "type": "de", "key": "{#separator}│ {#keys}Desktop" },
    { "type": "wm", "key": "{#separator}│ {#keys}WM" },
    { "type": "custom", "key": " ", "format": "{#separator}╰────────────────────────────────────────{#}" },

    { "type": "custom", "key": " ", "format": "{#separator}╭─[{#title} Software {#separator}]────────────────────────{#}" },
    { "type": "shell", "key": "{#separator}│ {#keys}Shell" },
    { "type": "wmtheme", "key": "{#separator}│ {#keys}WM theme" },
    { "type": "theme", "key": "{#separator}│ {#keys}Theme" },
    { "type": "icons", "key": "{#separator}│ {#keys}Icons" },
    { "type": "font", "key": "{#separator}│ {#keys}Font" },
    { "type": "cursor", "key": "{#separator}│ {#keys}Cursor" },
    { "type": "terminal", "key": "{#separator}│ {#keys}Terminal" },
    { "type": "terminalfont", "key": "{#separator}│ {#keys}Terminal font" },
    { "type": "locale", "key": "{#separator}│ {#keys}Locale" },
    { "type": "vulkan", "key": "{#separator}│ {#keys}Vulkan" },
    { "type": "opengl", "key": "{#separator}│ {#keys}OpenGL" },
    { "type": "custom", "key": " ", "format": "{#separator}╰────────────────────────────────────────{#}" },

    { "type": "custom", "key": " ", "format": "{#separator}╭─[{#title} Network {#separator}]───────────────────────{#}" },
    { "type": "localip", "key": "{#separator}│ {#keys}IP address" },
    { "type": "dns", "key": "{#separator}│ {#keys}DNS" },
    { "type": "wifi", "key": "{#separator}│ {#keys}Wi-Fi" },
    { "type": "bluetooth", "key": "{#separator}│ {#keys}Bluetooth" },
    { "type": "custom", "key": " ", "format": "{#separator}╰────────────────────────────────────────{#}"
    }
  ]
}

# Ensure local bin is in PATH
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$PATH:$HOME/.local/bin"
fi

# Go
if command -v go &>/dev/null; then
    export PATH="$PATH:$(go env GOPATH)/bin"
fi

# thefuck is unmaintained and crashes on newer Python versions in some distros; only
# load the alias when it works, so a crash does not print a traceback in every shell.
if command -v pay-respects &>/dev/null; then
    eval "$(pay-respects bash --alias fuck)"   # "zsh" in zshrc-user
elif command -v thefuck &>/dev/null; then
    if _thefuck_alias="$(thefuck --alias 2>/dev/null)"; then
        eval "$_thefuck_alias"
    fi
    unset _thefuck_alias
fi

if command -v zoxide &>/dev/null; then
    eval "$(zoxide init --cmd cd zsh)"
fi

if [ -f ~/.bash_aliases ]; then
	. ~/.bash_aliases
fi

ZSH_RPROMPT_INDENT=0

# Oh My Posh — shared prompt configuration (only when it and its config are installed)
if [[ -x "$HOME/.local/bin/oh-my-posh" && -f "$HOME/.config/ohmyposh/anna.omp.json" ]]; then
    eval "$("$HOME/.local/bin/oh-my-posh" init zsh --config "$HOME/.config/ohmyposh/anna.omp.json")"
fi

export EDITOR='nano'

# Suffix Aliases
alias -s conf="$EDITOR"
alias -s go="$EDITOR"
alias -s md="bat"
alias -s json="$EDITOR"
alias -s toml="$EDITOR"
alias -s taml="$EDITOR"
alias -s py="python3"

# Push initial prompt to bottom of window
printf '\n%.0s' {1..$LINES}
alias clear='clear && printf "\n%.0s" {1..$LINES}'

if [ -x "$HOME/.local/bin/welcome_banner.sh" ] && [[ $- == *i* ]]; then
    clear && "$HOME/.local/bin/welcome_banner.sh"
fi

# Ensure local bin is in PATH dynamically for the active user.
if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
    export PATH="$PATH:$HOME/.local/bin"
fi

if command -v thefuck &>/dev/null; then
    eval "$(thefuck --alias)"
fi

if command -v zoxide &>/dev/null; then
    eval "$(zoxide init --cmd cd bash)"
fi

if [ -d "/home/linuxbrew/.linuxbrew" ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

if [ -x "$HOME/.local/bin/welcome_banner.sh" ] && [[ $- == *i* ]]; then
    clear && "$HOME/.local/bin/welcome_banner.sh"
fi

# ble.sh — interactive Bash line editor
if [[ $- == *i* && -f "$HOME/.local/share/blesh/ble.sh" ]]; then
    source "$HOME/.local/share/blesh/ble.sh" --attach=none
fi

# Oh My Posh — shared prompt configuration (only when it and its config are installed)
if [[ $- == *i* && -x "$HOME/.local/bin/oh-my-posh" && -f "$HOME/.config/ohmyposh/anna.omp.json" ]]; then
    eval "$("$HOME/.local/bin/oh-my-posh" init bash --config "$HOME/.config/ohmyposh/anna.omp.json")"

    # ble.sh — Oh My Posh transient prompt (only when ble.sh was loaded above)
    if [[ ${BLE_VERSION-} ]]; then
        bleopt prompt_ps1_transient=always
        bleopt prompt_ps1_final='$( "$HOME/.local/bin/oh-my-posh" print transient --shell=bash --shell-version="$BASH_VERSION" --config="$HOME/.config/ohmyposh/anna.omp.json" --escape=false )'
    fi
fi

# Attach ble.sh after all prompt integrations have initialized
if [[ ${BLE_VERSION-} ]]; then
    ble-attach
fi